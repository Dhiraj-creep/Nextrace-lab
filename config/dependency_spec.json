{
  "application": "nextrace-orders-app",
  "version": "0.1.0",
  "services": {
    "gateway": {
      "role": "api_gateway",
      "public_endpoint": "http://127.0.0.1:18000",
      "dependencies": [
        {
          "target": "order-service",
          "protocol": "http",
          "expected_endpoint": "http://127.0.0.1:18001"
        }
      ]
    },
    "order-service": {
      "role": "application_service",
      "internal_endpoint": "http://127.0.0.1:18001",
      "dependencies": [
        {
          "target": "database",
          "protocol": "tcp",
          "expected_db_host": "127.0.0.1",
          "expected_db_port": 15432,
          "expected_db_name": "nextrace_orders"
        }
      ]
    },
    "database": {
      "role": "persistent_storage",
      "expected_host": "127.0.0.1",
      "expected_port": 15432,
      "dependencies": []
    }
  }
}
