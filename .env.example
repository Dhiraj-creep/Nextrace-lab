# NexTrace Phase 2 — Example Environment Configuration (No Secrets)
# Copy to .env if customizing ports, runtime mode, or AI provider settings.

# Runtime mode: 'auto' (default), 'local' (OS subprocesses), or 'docker' (Docker Compose)
NEXTRACE_RUNTIME=auto

# Host TCP ports
HOST_GATEWAY_PORT=18000
HOST_ORDER_PORT=18001
HOST_DB_PORT=15432

# Non-secret database settings
DB_HOST=127.0.0.1
DB_PORT=15432
DB_NAME=nextrace_orders
DB_USER=nextrace_user
# Set a local development password in your untracked .env file when using Docker Compose:
DB_PASSWORD=replace_with_local_dev_password
DB_CONNECT_TIMEOUT_SEC=1.0

# Gateway downstream settings
ORDER_SERVICE_URL=http://127.0.0.1:18001
ORDER_SERVICE_TIMEOUT_SEC=2.5

# Optional AI Selector Configuration (only required when running method 'ai_adaptive_v1')
# NEXTRACE_AI_PROVIDER=gemini
# NEXTRACE_AI_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=your_api_key_here
# OPENAI_API_KEY=your_api_key_here
# NEXTRACE_AI_PRICE_PER_1K_INPUT_USD=0.00015
# NEXTRACE_AI_PRICE_PER_1K_OUTPUT_USD=0.00060
